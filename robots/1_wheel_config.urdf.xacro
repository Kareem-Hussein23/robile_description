<?xml version='1.0'?>

<robot xmlns:xacro="http://ros.org/wiki/xacro" name="1_wheel_config">

    <xacro:arg name="use_real_inertia" default="false"/>

    <!-- Robile bricks -->
    <xacro:include filename="$(find robile_description)/urdf/robile_bricks/robile_active_wheel_brick.urdf.xacro" />
    <xacro:include filename="$(find robile_description)/urdf/robile_bricks/robile_passive_wheel_brick.urdf.xacro" />
    <xacro:include filename="$(find robile_description)/urdf/robile_bricks/robile_cpu_brick.urdf.xacro" />
    <xacro:include filename="$(find robile_description)/urdf/robile_bricks/robile_master_battery_brick.urdf.xacro" />

    <!-- Gazebo / ros2_control -->
    <xacro:include filename="$(find robile_description)/gazebo/1_wheel_ros2_control_config.xacro"/>

    <link name="base_link"/>

    <!-- Front: single centered active drive module -->
    <xacro:robile_active_wheel_brick
        name="robile_5"
        parent="base_link"
        use_real_inertia="$(arg use_real_inertia)">
        <origin xyz="-0.233 0 0.05" rpy="0 0 0"/>
    </xacro:robile_active_wheel_brick>

    <!-- Middle: CPU and battery -->
    <xacro:robile_cpu_brick name="robile_3" parent="base_link">
        <origin xyz="0 0.1165 0.05" rpy="0 0 0"/>
    </xacro:robile_cpu_brick>

    <xacro:robile_master_battery_brick name="robile_4" parent="base_link">
        <origin xyz="0 -0.1165 0.05" rpy="0 0 0"/>
    </xacro:robile_master_battery_brick>

    <!-- Back: two passive caster modules -->
    <xacro:robile_passive_wheel_brick name="robile_1" parent="base_link">
        <origin xyz="0.233 0.1165 0.05" rpy="0 0 0"/>
    </xacro:robile_passive_wheel_brick>

    <xacro:robile_passive_wheel_brick name="robile_2" parent="base_link">
        <origin xyz="0.233 -0.1165 0.05" rpy="0 0 0"/>
    </xacro:robile_passive_wheel_brick>

</robot>
