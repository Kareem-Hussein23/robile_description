<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find robile_description)/urdf/sensors/common.xacro"/>

    <xacro:macro name="sick_microscan3" params="*origin name:=base_laser_front 
                                          ros_topic parent:=base_link
                                          sample_size:=540 update_rate:=10
                                          min_angle:=-2.35619 max_angle:=2.35619
                                          min_range:=0.1 max_range:=40.0 visualize:=true">
        <joint name="${name}_joint" type="fixed">
            <axis xyz="0 1 0" />
            <xacro:insert_block name="origin" />
            <parent link="${parent}"/>
            <child link="${name}_link"/>
        </joint>

        <link name="${name}_link" type="laser">
            <inertial>
                <mass value="0.001" />
                <origin xyz="0 0 0" rpy="0 0 0" />
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.0001" />
            </inertial>
            <visual>
                <origin xyz="0 0 -0.06" rpy="1.57 0 0" />
                <geometry>
                    <mesh filename="package://robile_description/meshes/sensors/SICK_MICROSCAN3.dae" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 -0.06" rpy="1.57 0 0" />
                <geometry>
                    <mesh filename="package://robile_description/meshes/sensors/SICK_MICROSCAN3.dae" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
        </link>
        
        <xacro:gazebo_laser_plugin name="${name}" topic="${ros_topic}" sample_size="${sample_size}" update_rate="${update_rate}"
                                min_angle="${min_angle}" max_angle="${max_angle}" min_range="${min_range}" max_range="${max_range}"
                                visualize="${visualize}" sensor_type="gpu_lidar"/>
    </xacro:macro>
</robot>