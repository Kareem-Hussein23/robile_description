<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gazebo_laser_plugin" params="name topic sample_size update_rate 
                                                    min_angle max_angle min_range max_range
                                                    visualize sensor_type:=gpu_lidar " >
                        
    <gazebo reference="${name}_link">

        <sensor type="${sensor_type}" name="${name}">
            <pose>0 0 0 0 0 0</pose>
            <visualize>${visualize}</visualize>
            <update_rate>${update_rate}</update_rate>

            <lidar>
                <scan>
                    <horizontal>
                        <samples>${sample_size}</samples>
                        <resolution>1</resolution>
                        <min_angle>${min_angle}</min_angle>
                        <max_angle>${max_angle}</max_angle>
                    </horizontal>
                </scan>

                <range>
                    <min>${min_range}</min>
                    <max>${max_range}</max>
                    <resolution>0.01</resolution>
                </range>
                
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.005</stddev>
                </noise>
            </lidar>

            <topic>${topic}</topic>
            <gz_frame_id>${name}_link</gz_frame_id>

        </sensor>
    </gazebo>

    </xacro:macro>
</robot>