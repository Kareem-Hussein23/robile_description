<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="ros2_control" params="config_file_name">
        <gazebo>
            <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
                <parameters>$(find robile_gazebo)/config/ros_controller/${config_file_name}.yaml</parameters>
                <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
            </plugin>
            <plugin filename="libgz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
                <dimensions>3</dimensions>
                <odom_publish_frequency>2000</odom_publish_frequency>
                <odom_frame>odom</odom_frame>
                <robot_base_frame>base_link</robot_base_frame>
            </plugin>
        </gazebo>
    </xacro:macro>
    <xacro:macro name="joint_interface" params="joint_name">
        <joint name="${joint_name}">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </xacro:macro>
    <xacro:macro name="active_wheel_interfaces" params="name">
        <xacro:joint_interface joint_name="${name}_drive_pivot_joint"/>
        <xacro:joint_interface joint_name="${name}_drive_left_hub_wheel_joint"/>
        <xacro:joint_interface joint_name="${name}_drive_right_hub_wheel_joint"/>
    </xacro:macro>
</robot>
